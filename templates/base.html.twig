<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css"
         integrity="sha512-MV7K8+y+gLIBoVD59lQIYicR65iaqukzvf/nwasF0nqhPay5w/9lJmVM2hMDcnK1OnMGCdVK+iQrJ7lzPJQd1w=="
         crossorigin="anonymous" referrerpolicy="no-referrer" />

        {% block stylesheets %}
            {{ importmap('app') }}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}
    </head>
    <body>
        <div id="main-container">
            {% set hideMenuRoutes = ['app_home', 'app_login', 'app_register', 'app_register_success', '2fa_login'] %}
            {% if app.request.attributes.get('_route') not in hideMenuRoutes %}
                <nav class="navbar d-block">
                    <a href="/" id="logo">
                        <img src="{{ asset('/images/logo.png') }}" alt="Logo TaskLinker" />
                    </a>
                    <ul id="main-menu">
                        <li class="{{ app.request.attributes.get('_route') starts with 'app_employe' ? '' : 'active' }}">
                            <a href="{{ path('app_projet') }}">
                            <i class="fa-solid fa-list-check"></i> Projets
                            </a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'app_employe' ? 'active' : '' }}">
                            <a href="{{ path('app_employe_list') }}">
                            <i class="fa-regular fa-user"></i> Équipe
                            </a>
                        </li>
                    </ul>
                </nav>
            {% endif %}
            <main>
                {% if app.request.attributes.get('_route') not in hideMenuRoutes %}
                    <header class="flex flex-col text-white">
                        <div id="current-user" class="relative" data-controller="dropdown" data-action="click@window->dropdown#close">
                            {% if app.user %}
                                <button type="button" data-action="dropdown#toggle" id="user-menu-button" class="focus:outline-none block ms-auto">
                                    <div class="avatar-reverse cursor-pointer hover:opacity-80 transition-opacity">
                                        {{ app.user.prenom|slice(0, 1) }}{{ app.user.nom|slice(0, 1) }}
                                    </div>
                                </button>

                                <div id="user-menu-dropdown" data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-xl border border-gray-200 z-50 overflow-hidden">
                                    <div class="px-4 py-2 text-xs text-gray-400 bg-gray-50 border-b">
                                        {{ app.user.prenom }} {{ app.user.nom }}
                                    </div>
                                    <a href="{{ path('app_logout') }}" class="flex items-center px-4 py-3 text-sm text-red-600 hover:bg-red-50 transition-colors">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                        </svg>
                                        Déconnexion
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                        <div id="title-page" class="flex-grow">
                            {% block header %}{% endblock %}
                        </div>
                    </header>
                {% endif %}
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
