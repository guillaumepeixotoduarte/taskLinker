{% extends 'base.html.twig' %}

{% block title %}Modifier l'employé{% endblock %}

{% block body %}
<header>
    <div id="current-user"></div>
    <div id="title-page">
        <h1>{{employe.prenom}} {{employe.nom}}</h1>
    </div>
</header>

<div id="content">

    {{ form_start(form) }}
        <div>
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom, {'attr': {'class': ''}}) }}
        </div>
        <div>
            {{ form_label(form.prenom) }}
            {{ form_widget(form.prenom, {'attr': {'class': ''}}) }}
        </div>
        <div>
            {{ form_label(form.email) }}
            {{ form_widget(form.email, {'attr': {'class': ''}}) }}
        </div>
        <div class="form-flex">
            <div class="">
                {{ form_label(form.dateEntree) }}
                {{ form_widget(form.dateEntree, {'attr': {'class': ''}}) }}
            </div>
            <div class="">
                {{ form_label(form.statut) }}
                {{ form_widget(form.statut, {'attr': {'class': ''}}) }}
            </div>
        </div>
        <button class="button button-submit">Enregistrer</button>
    {{ form_end(form) }}
</div>
{% endblock %}
