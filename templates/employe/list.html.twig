{% extends 'base.html.twig' %}

{% block title %}Liste des employés{% endblock %}

{% block body %}
<header>
    <div id="current-user"></div>
    <div id="title-page">
        <h1>Equipe</h1>
    </div>
</header>

<div id="content">

    <table id="team-container">
        <thead>
            <tr>
                <th>Prénom, Nom</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for employe in employes %}
                <tr>
                    <td>
                        <div class="employee-infos">
                            <div class="employee-avatar">
                                {{ employe.prenom|slice(0, 1) }}{{ employe.nom|slice(0, 1) }}
                            </div>
                            <div class="employee-coords">
                                <strong>{{ employe.prenom }} {{ employe.nom }}</strong>
                                <span>{{ employe.email }}</span>
                            </div>
                        </div>
                    </td>
                    <td>{{ employe.statut }}</td>
                    <td>
                        <a class="button button-edit-team" href="{{ path('app_employe_edit', {'id': employe.id}) }}">
                            Éditer
                        </a>
                        <form method="post" class="w-auto" action="{{ path('app_employe_delete', {id: employe.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet employé ?');" >
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employe.id) }}">
                            <button class="delete-team" type="submit">
                                Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}

