{% extends 'base.html.twig' %}
{% block title %} {% if projet.titre != '' %} Modifier {{ projet.titre }} {% else %} Nouveau projet {% endif %} {% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
{% endblock %}

{% block header %}
    <h1>{% if projet.titre != '' %} {{ projet.titre }} {% else %} Nouveau projet{% endif %}</h1>
{% endblock %}

{% block body %}

<div id="content">

    {{ form_start(form) }}
        <div>
            {{ form_label(form.titre) }}
            {{ form_widget(form.titre, {'attr': {'class': ''}}) }}
        </div>
        <div>
            {{ form_label(form.employes) }}
            {{ form_widget(form.employes, {'attr': {'class': '', 'id': 'projet_employes'}}) }}
        </div>
        <br>
        <button class="button button-submit">Enregistrer</button>
    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}

        {{ parent() }}
        <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        <script>
            document.addEventListener('turbo:load', function() {
                console.log("Turbo a chargé la page, on initialise les composants !");

                const selectElement = document.querySelector('#projet_employes');

                if (selectElement) {
                    if (typeof jQuery !== 'undefined') {
                        $(selectElement).select2();
                    }
                }
            });
        </script>
{% endblock %}
