{% extends 'base.html.twig' %}

{% block title %}Hello ProjetController!{% endblock %}

{% block body %}
<header>
    <div id="current-user"></div>
    <div id="title-page">
        <div class="flex-header">
            <h1>{{ projet.titre }}</h1>
            <div class="user-list">
                {% for employe in projet.employes %}
                    <div class="avatar">{{ employe.prenom|slice(0, 1) }}{{ employe.nom|slice(0, 1) }}</div>
                {% endfor %}
            </div>
            <a class="button" href="{{ path('app_projet_edit', {'id': projet.id}) }}">Modifier</a>
        </div>
    </div>
</header>

<div id="content">
    <div id="tasks-container">
        <div class="task-column">
            <h2>To Do</h2>
            <div class="tasks-list">
                {% for tache in projet.taches|filter(tache => tache.statut == 'A_FAIRE') %}
                    <a class="task" href="{{ path('app_tache_edit', {'id': tache.id}) }}">
                        <h3>{{ tache.titre }}</h3>
                        <p>{{ tache.description }}</p>
                        <div class="task-infos">
                            <div class="task-deadline">
                                <i class="bi bi-calendar"></i> {{ tache.date ? tache.date|date('d/m/Y') : 'Pas de date' }}
                            </div>
                            {% if tache.employe %}
                                <div class="mini-user">
                                    {{ tache.employe.prenom|slice(0, 1) }}{{ tache.employe.nom|slice(0, 1) }}
                                </div>
                            {% endif %}                                
                        </div>
                    </a>
                {% endfor %}
                <a href="/tache/new/{{ projet.id }}" class="task-add">
                    + Ajouter une tâche
                </a>
            </div>
        </div>
        <div class="task-column">
            <h2>Doing</h2>
            <div class="tasks-list">
                {% for tache in projet.taches|filter(tache => tache.statut == 'EN_COURS') %}
                    <a class="task" href="{{ path('app_tache_edit', {'id': tache.id}) }}">
                        <h3>{{ tache.titre }}</h3>
                        <p>{{ tache.description }}</p>
                        <div class="task-infos">
                            <div class="task-deadline">
                                <i class="bi bi-calendar"></i> {{ tache.date ? tache.date|date('d/m/Y') : 'Pas de date' }}
                            </div>
                            {% if tache.employe %}
                                <div class="mini-user">
                                    {{ tache.employe.prenom|slice(0, 1) }}{{ tache.employe.nom|slice(0, 1) }}
                                </div>
                            {% endif %}  
                        </div>
                    </a>
                {% endfor %}
                <a href="/tache/new/{{ projet.id }}" class="task-add">
                    + Ajouter une tâche
                </a>
            </div>
        </div>
        <div class="task-column">
            <h2>Done</h2>
            <div class="tasks-list">
                {% for tache in projet.taches|filter(tache => tache.statut == 'TERMINE') %}
                    <a class="task" href="{{ path('app_tache_edit', {'id': tache.id}) }}">
                        <h3>{{ tache.titre }}</h3>
                        <p>{{ tache.description }}</p>
                        <div class="task-infos">
                            <div class="task-deadline">
                                <i class="bi bi-calendar"></i> {{ tache.date ? tache.date|date('d/m/Y') : 'Pas de date' }}
                            </div>
                            {% if tache.employe %}
                                <div class="mini-user">
                                    {{ tache.employe.prenom|slice(0, 1) }}{{ tache.employe.nom|slice(0, 1) }}
                                </div>
                            {% endif %}  
                        </div>
                    </a>
                {% endfor %}
                <a href="/tache/new/{{ projet.id }}" class="task-add">
                    + Ajouter une tâche
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
