{% extends 'base.html.twig' %}

{% block title %}Projets{% endblock %}

{% block header %}
    <h1>{{ title }}</h1>
{% endblock %}

{% block body %}

<div id="content">
    <div id="projects-container">
        {% for projet in projets %}
            <article class="card-project">
                <a href="{{ path('app_projet_details', {'id': projet.id}) }}">
                <h2 class="fw-semibold">{{ projet.titre }}</h2>
                </a>
                <div class="card-project-icons">
                <a href="{{ path('app_projet_edit', {'id': projet.id}) }}">
                    <i class="fa-solid fa-pen"></i>
                </a>
                <form method="post" class="w-auto" action="{{ path('app_projet_archive', {id: projet.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir archiver ce projet ?');" >
                    <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ projet.id) }}">
                    <button class="delete-team cursor-pointer" type="submit">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </form>
                </div>
            </article>
        {% endfor %}
        {% if is_granted('ROLE_CHEF_PROJET') %}
            <article class="card-project">
                <a href="{{ path('app_projet_add') }}">
                    <i class="bi bi-plus-circle-fill add-project-icon"></i>
                    <h2 class="fw-semibold">Ajouter un projet</h2>
                </a>
            </article>
        {% endif %}
    </div>
</div>
{% endblock %}
