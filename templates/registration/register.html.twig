{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}


    <div class="auth-container">
        <div class="auth-title">
            <img src="{{ asset('/images/logo.png') }}" alt="Logo TaskLinker" />
        </div>
        <div class="auth-content p-10">

            {{ form_start(registrationForm) }}

                <h1 class="text-white text-[34px] font-bold text-center mb-10">S'inscrire</h1>

                <div class="mb-4">
                    {{ form_label(registrationForm.nom, null, {'label_attr': {'class': 'block text-white mb-2'}}) }}
                    {{ form_widget(registrationForm.nom, {'attr': {'class': 'w-full p-2 rounded mb-1'}}) }}
                    {{ form_errors(registrationForm.nom) }}
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.prenom, null, {'label_attr': {'class': 'block text-white mb-2'}}) }}
                    {{ form_widget(registrationForm.prenom, {'attr': {'class': 'w-full p-2 rounded mb-1'}}) }}
                    {{ form_errors(registrationForm.prenom) }}
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'block text-white mb-2'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full p-2 rounded mb-1'}}) }}
                    {% for error in registrationForm.email.vars.errors %}
                        <p class="text-red-800 bg-red-100/90 border-l-4 border-red-600 p-2 mt-2 text-sm rounded-r shadow-sm">
                            ⚠ {{ error.message }}
                        </p>
                    {% endfor %}
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'block text-white mb-2'}}) }}
                    {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'mb-1'}}) }}
                    {% for error in registrationForm.plainPassword.first.vars.errors %}
                        <p class="text-red-800 bg-red-100/90 border-l-4 border-red-600 p-2 mt-2 text-sm rounded-r shadow-sm">
                            ⚠ {{ error.message }}
                        </p>
                    {% endfor %}

                    <div class="mt-4">
                        {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'block text-white mb-2'}}) }}
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'mb-1'}}) }}
                    </div>
                </div>


                <button class="mt-8 w-full py-[25px] text-white bg-[#1C5B50] text-[14px] rounded-xl" type="submit">
                    Continuer
                </button>
                <a class="text-white text-center mt-4 text-[14px] flex justify-center" href="{{ path('app_login') }}">
                    Vous avez déjà un compte ?
                </a>
            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
