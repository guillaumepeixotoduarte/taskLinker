{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto bg-white p-8 rounded-lg shadow">
        <h1 class="text-2xl font-bold mb-6">Rejoindre TaskLinker</h1>

        {{ form_start(registrationForm) }}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {{ form_row(registrationForm.nom) }}
                {{ form_row(registrationForm.prenom) }}
            </div>

            {{ form_row(registrationForm.email) }}

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                {{ form_row(registrationForm.date_entree) }}
                {{ form_row(registrationForm.statut) }}
            </div>

            <div class="bg-blue-50 p-4 rounded mt-4">
                {{ form_row(registrationForm.isChefProjet) }}
            </div>

            {{ form_row(registrationForm.plainPassword) }}
            {{ form_row(registrationForm.agreeTerms) }}

            <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded mt-6 hover:bg-blue-700">
                Créer mon compte
            </button>
        {{ form_end(registrationForm) }}
    </div>
{% endblock %}
