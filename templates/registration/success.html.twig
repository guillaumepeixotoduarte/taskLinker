{% extends 'base.html.twig' %}

{% block title %}Sécurisez votre compte - TaskLinker{% endblock %}

{% block body %}
    <div class="auth-container min-h-screen flex items-center justify-center bg-gray-100 py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full space-y-8 bg-white p-10 rounded-xl shadow-lg border-t-4 border-[#1C5B50]">

            <div class="text-center">
                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100 mb-4">
                    <svg class="h-6 w-6 text-green-600 relative" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <h2 class="text-3xl font-extrabold text-gray-900">Compte créé !</h2>
                <p class="mt-2 text-sm text-gray-600">
                    Dernière étape : activez la double authentification (2FA).
                </p>
            </div>

            <div class="mt-8 space-y-6">
                <div class="bg-gray-50 p-4 rounded-lg border border-dashed border-gray-300 text-center">
                    <p class="text-xs text-gray-500 mb-4 uppercase tracking-widest font-semibold">Scannez ce QR Code</p>

                    {# Génération du QR Code via une API simple ou un bundle #}
                    <div class="flex justify-center mb-4">
                        <img src="{{ qrCodeDataUri }}"
                            alt="QR Code de sécurité"
                            class="border-4 border-white shadow-sm">
                    </div>

                    <p class="text-sm text-gray-600">
                        Ouvrez votre application de sécurité et ajoutez un compte en scannant ce code.
                    </p>
                </div>

                <div class="rounded-md bg-blue-50 p-4">
                    <div class="">
                        <div class="ml-3">
                            <h3 class="flex text-sm font-medium text-blue-800">
                                <svg class="h-5 w-5 text-blue-400 me-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                                </svg>
                                Code de secours
                            </h3>
                            <div class="mt-2 text-sm text-blue-700">
                                <p>Si vous ne pouvez pas scanner le code, entrez manuellement : <br>
                                <strong class="font-mono text-lg tracking-wider break-all">{{ secret }}</strong>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <a href="{{ path('app_login') }}"
                    class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-[#1C5B50] hover:bg-[#164a41] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1C5B50] transition-colors">
                        Continuer vers la connexion
                    </a>
                </div>

                <p class="text-center text-xs text-red-500 italic">
                    Attention : une fois cette page quittée, vous ne pourrez plus voir ce code.
                </p>
            </div>
        </div>
    </div>
{% endblock %}
